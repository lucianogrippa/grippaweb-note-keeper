@startuml
title access - sequence diagram

actor "User" as user

participant "Frontend" as frontend

participant "Credential Service" as credentialService

database "Database" as db #fafafa

== User access to app ==

user -> frontend: open application

frontend -> credentialService: is db exists?

alt "database not exisist" 

credentialService -> frontend: setup_master_password

frontend -> user: show registration form (db path,name,username,password and master password)

user -> frontend: submit form

frontend -> credentialService: validate form

alt "form not valid"

credentialService -> frontend: invalid_form + details

frontend -> user: show errors

user -> frontend: fix errors and submit

frontend -> credentialService: submit valid form 

end

credentialService -> db: create db and create user profile

end

db -> credentialService: db exists

credentialService --> frontend: sen event ask_master_passord

frontend -> user: show master password form

user -> frontend: submit master password form

frontend -> credentialService: ask for access

alt "wrong master password"

credentialService -> db: try_access

db -> credentialService: wrong_password

credentialService --> frontend: error_wrong_credential

frontend -> user: show error crediantial

end

credentialService -> db: with master password ask user profile

db -> credentialService: retrive user profile



credentialService -> credentialService: create and store session token

credentialService -> frontend:  send user profile info + token

frontend -> user: navigate to home view


@enduml