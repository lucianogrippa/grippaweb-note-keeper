Table groups {
    id Text [pk, default: `(lower(hex(randomblob(16))))`]
    categories_id Text [not null, ref: > categories.id]
    name Text [not null]
    created_at timestamp [not null]
    updated_at timestamp [not null]
    note: 'This table represents groups of notes within a category. Each group can contain multiple notes. The created_at and updated_at fields track when the group was created and last updated.'
}

Table user_profile {
    id Text [pk, default: `(lower(hex(randomblob(16))))`]
    full_name Text [not null]
    password_hash Text [not null]
    created_at timestamp [not null]
    updated_at timestamp [not null]
    note: 'This table represents the user profile. Each user can have multiple categories of notes. The password_hash field is used to store the hashed password for authentication purposes, and the created_at and updated_at fields track when the user profile was created and last updated.'
}

Table categories {
    id Text [pk, default: `(lower(hex(randomblob(16))))`]
    user_id Text [not null, ref: > user_profile.id]
    name Text [not null]
    description Text
    created_at timestamp [not null]
    updated_at timestamp [not null]
    note: 'This table represents categories of notes for a user. Each category can have multiple groups of notes. The description field is optional and can be used to provide additional information about the category.'

}

Table  notes {
    id Text [pk, default: `(lower(hex(randomblob(16))))`]
    groups_id Text [not null, ref: > groups.id]
    title Text [not null]
    content Text [not null]
    is_encrypted boolean [not null, default: false]
    created_at timestamp [not null]
    updated_at timestamp [not null]
    note: 'This table represents individual notes. Each note belongs to a group, which in turn belongs to a category. The is_encrypted field indicates whether the content of the note is encrypted, which can be useful for sensitive information.'
}

Table db_version {
    id Text [pk, default: `(lower(hex(randomblob(16))))`]
    created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
    ver Text [not null]

    note: 'This table is used to track the version of the database schema. It can be useful for managing migrations and ensuring compatibility with different versions of the application.'
}
